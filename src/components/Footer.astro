---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "关于", href: getRelativeLocaleUrl(locale, "about") },
  {
    label: "联系",
    href: `${getRelativeLocaleUrl(locale, "about")}#联系方式`,
  },
  { label: "隐私政策", href: getRelativeLocaleUrl(locale, "privacy") },
  {
    label: "RSS",
    href: `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`,
  },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center gap-2 border-t py-6 sm:py-4"
  >
    <Socials />
    <p class="whitespace-nowrap">
      &#169; {currentYear} {config.site.title} · 原创内容，转载请注明出处
    </p>
    <nav aria-label="页脚导航">
      <ul class="flex items-center gap-x-3 text-sm">
        {
          footerLinks.map(({ label, href }, index) => (
            <>
              {index > 0 && (
                <li aria-hidden="true" class="text-muted-foreground">
                  ·
                </li>
              )}
              <li>
                <a class="hover:text-accent transition-colors" href={href}>
                  {label}
                </a>
              </li>
            </>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
