---
import type { MarkdownHeading } from "astro";

type Props = {
  headings: MarkdownHeading[];
};

const { headings } = Astro.props;

const tocHeadings = headings.filter(
  heading => heading.depth <= 3 && heading.text.trim() !== ""
);
---

{
  tocHeadings.length >= 3 && (
    <details
      id="toc"
      open
      class="border-border bg-muted/30 my-8 rounded-lg border p-4"
    >
      <summary class="cursor-pointer font-medium select-none">目录</summary>
      <nav class="mt-3" aria-label="目录">
        <ul class="space-y-2 text-sm">
          {tocHeadings.map(heading => (
            <li class:list={{ "ps-5": heading.depth === 3 }}>
              <a
                href={`#${heading.slug}`}
                class="text-muted-foreground hover:text-accent decoration-dashed underline-offset-4 transition-colors hover:underline"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}