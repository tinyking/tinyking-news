---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import AdSlot from "@/components/AdSlot.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { CATEGORIES } from "@/categories";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const categoryEntries = CATEGORIES.filter(category =>
  sortedPosts.some(({ data }) => data.category === category.slug)
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="mt-4 mb-2 inline-block text-4xl font-bold sm:mt-8 sm:text-5xl">
        {config.site.title}
      </h1>

      <p
        class="border-accent text-accent mt-2 border-s-2 ps-3 text-xl font-medium sm:text-2xl"
      >
        于细微处读世事
      </p>
      <p class="mt-3">
        写人生成长，聊 AI 与工具，记职场经验，也想想那些没有标准答案的问题。
      </p>

      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="text-muted-foreground hover:text-accent mt-4 inline-flex items-center gap-1.5 text-sm transition-colors"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss width={16} height={16} class="stroke-accent stroke-2" />
        <span>RSS</span>
      </a>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      categoryEntries.length > 0 && (
        <section
          id="categories"
          class:list={[
            "pt-12 pb-6",
            {
              "border-border border-b":
                featuredPosts.length > 0 || recentPosts.length > 0,
            },
          ]}
        >
          <h2 class="text-xl font-semibold">栏目</h2>
          <ul class="mt-4 flex flex-wrap gap-3">
            {categoryEntries.map(({ slug, name, desc }) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, slug)}
                  title={desc}
                  class="border-border text-foreground hover:text-accent hover:border-accent rounded-md border px-3 py-1.5 transition-colors"
                >
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-xl font-semibold">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-xl font-semibold">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <AdSlot
      slot={config.features.ads?.slots?.homeBottom}
      class="mt-8"
      label="广告"
    />

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
